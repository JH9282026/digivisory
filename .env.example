# ============================================================
# DVB CMS - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Site Configuration ─────────────────────────
# The public URL of your site (no trailing slash)
SITE_URL=http://localhost
# Name displayed in header and meta tags
SITE_NAME=My Blog

# ─── Database (PostgreSQL) ──────────────────────
# These are used by both Docker and the application
POSTGRES_USER=dvbcms
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=dvbcms
# Internal connection string (auto-built in docker-compose, override for external DB)
# DATABASE_URL=postgresql://dvbcms:changeme@db:5432/dvbcms?schema=public
# Expose DB on this host port (default 5433 to avoid conflicts)
DB_EXTERNAL_PORT=5433

# ─── NextAuth.js ────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_SECRET
# Must match your site URL
NEXTAUTH_URL=http://localhost

# ─── Admin Account (initial setup) ─────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# ─── Seed database on first run ────────────────
# Set to 'true' for initial setup, then set to 'false'
SEED_DATABASE=true

# ─── File Storage ───────────────────────────────
# Options: 's3' or 'local'
STORAGE_PROVIDER=local

# AWS S3 Configuration (only if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# ─── HTTP Ports ─────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ─── Email (optional, for notifications) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ─── Redis ──────────────────────────────────────
# Auto-configured in Docker; override for external Redis
# REDIS_URL=redis://redis:6379

# ─── Advanced ───────────────────────────────────
# NODE_ENV is set automatically by Docker
# NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
